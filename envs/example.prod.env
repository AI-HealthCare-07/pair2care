# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
# prod면 refresh 쿠키에 Secure가 붙어 https에서만 저장됨 → 인증서 붙이기 전 http(IP) 리허설은 dev로
ENV=prod
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
# 비워 두면 쿠키가 지금 접속한 주소(IP·도메인)에만 붙음. localhost로 두면 배포 주소에서 쿠키가 저장 안 됨
COOKIE_DOMAIN=

# ai-worker
AI_WORKER_VERSION=v1.0.0
# Claude 추천(DAILY_ACTION 등, docs/LLM_IMPLEMENTATION.md). 키 값은 .prod.env에만, 비어 있으면 추천 작업이 실패함
ANTHROPIC_API_KEY=
# 배포는 Sonnet (CLAUDE.md 5장: 개발·테스트는 Haiku)
CLAUDE_MODEL=claude-sonnet-5-5

# db
DB_HOST=mysql
DB_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=Password1234@
DB_ROOT_PASSWORD=Ozcoding1234@
DB_NAME=ai_health

# redis
REDIS_PORT=6379

# ai-worker: Consumer 이름. 비워 두면 호스트명 사용 (워커 여러 대면 이름이 겹치지 않게)
WORKER_NAME=
