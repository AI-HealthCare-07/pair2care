// Pair 2 Care ERD (DBML) — dbdiagram.io에 통째로 붙여넣으면 그림으로 보임
// 뼈대: PK·FK·created_at만 넣어 둠. 나머지 컬럼은 담당자가 채움 (목록·후보 컬럼은 docs/erd.md)
// 타입 표기: bigint, int, smallint, tinyint, varchar(n), text, decimal(5,1), date, time, datetime, bool, json, enum
// 담당: 김지연 = 회원·프로필·예측·LLM·알림 / 이지희 = 챌린지·짝꿍·건강 기록·식단

Project pair2care {
  database_type: 'MySQL'
  Note: 'OZ 2조 Pair 2 Care. REQ 번호는 docs/requirements.md 기준'
}

// ───────── 김지연 ─────────
Enum gender_type {
  MALE
  FEMALE
}

Enum agreement_type {
  TERMS
  PRIVACY
  SENSITIVE_HEALTH
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  hashed_password varchar(128) [not null]
  nickname varchar(50) [not null]
  gender gender_type [not null]
  birthday date [not null]
  quiet_start time [null]        // 방해 금지 시작 (null이면 사용 안 함)
  quiet_end time [null]          // 방해 금지 끝 (시작보다 이르면 다음 날까지)
  is_active bool [not null, default: true]
  is_admin bool [not null, default: false]
  last_login datetime [null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table user_consents {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  agreement agreement_type [not null]
  version varchar(20) [not null]        // 약관 버전 ('v1.0', 'v1.1')
  is_agreed bool [not null]             // 동의 여부 (true: 동의, false: 철회/미동의)
  created_at datetime [not null]        // 동의 또는 철회한 정확한 시각
}

Enum survey_kind {
  ONBOARDING    // 가입 때 첫 설문
  WEEKLY        // 주 1회 재설문
}

Table health_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  kind survey_kind [not null]
  survey_version varchar(20) [not null]   // 예: 'v1.0' (질문이 바뀌면 올림)
  // 코드 값은 docs/survey-mapping.md (국건영 코드 그대로, 건너뛴 문항도 코드로 저장)
  // 신체
  height_cm decimal(4,1) [not null]        // HE_ht, 예측
  weight_kg decimal(4,1) [not null]        // HE_wt, 예측
  waist_cm decimal(4,1) [null]             // HE_wc, 기록용 (선택), 재설문 때 안 적으면 복사하지 않고 null (측정일 = created_at)
  // 가족력: 예 1 / 아니오 0 / 모름 9 / 형제자매 없음 8 (형제자매만)
  father_diabetes_history tinyint [not null]       // HE_DMfh1
  mother_diabetes_history tinyint [not null]       // HE_DMfh2
  sibling_diabetes_history tinyint [not null]      // HE_DMfh3
  father_hypertension_history tinyint [not null]   // HE_HPfh1
  mother_hypertension_history tinyint [not null]   // HE_HPfh2
  sibling_hypertension_history tinyint [not null]  // HE_HPfh3
  // 음주
  alcohol_ever tinyint [not null]          // BD1: 없다 1 / 있다 2 (건너뛰기용)
  alcohol_frequency tinyint [not null]     // BD1_11: 1~6, 비해당 8
  alcohol_amount tinyint [not null]        // BD2_1: 1~5, 비해당 8
  binge_frequency tinyint [not null]       // BD2_31: 1~5, 비해당 8, 기록용
  // 흡연
  smoking_lifetime tinyint [not null]      // BS1_1: 5갑 미만 1 / 이상 2 / 없음 3 (건너뛰기용)
  smoking_current tinyint [not null]       // BS3_1: 매일 1 / 가끔 2 / 지금은 안 피움 3, 비해당 8
  cigarettes_per_day smallint [not null]   // BS3_2: 1~60, 비해당 888, 기록용
  heated_tobacco tinyint [not null]        // BS12_47: 매일 1 / 가끔 2 / 과거 3 / 안 함 8, 기록용
  liquid_ecig tinyint [not null]           // BS12_2: 현재 1 / 과거 2 / 안 함 8, 기록용
  // 진단 여부 (예면 그 질환은 예측 안 함)
  is_hypertension_diagnosed bool [not null]
  is_diabetes_diagnosed bool [not null]
  is_pregnant bool [null, note: '여성만, 예면 두 질환 모두 예측 안 함 (모델이 임신부를 빼고 학습)']   // 남성은 null, 재설문에서도 물음 (11/19 데이터팀 요청)
  created_at datetime [not null]          // 설문 응답 시각 (예측 나이 기준)

  indexes {
    (user_id, created_at)                 // 내 최신 설문 조회용
  }

  Note: 'REQ-PROF-001, PRED-004 · 재설문마다 새 행(기록용) · 재설문에서 안 묻는 항목은 직전 행 값 복사 → 최신 행 하나가 완전한 모델 입력 (허리둘레는 복사 안 함) · 재설문에서 상위 답(10·11·14·15)이 바뀌면 건너뛰기 상태가 달라진 하위 문항만 다시 물음: 새로 해당되면 다시 묻고, 해당 안 되면 8 / 888 자동 저장 · 성별·나이는 users에서 (created_at 기준 만 나이)'
}

Enum checkup_source {
  MANUAL      // 사용자 직접 입력
  OCR         // 검진 결과지 사진/PDF 인식
}

// "건강검진 결과지 한 장 = 한 행"
Table checkup_records {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  checked_on date [not null]                                        // 검진 받은 날
  systolic_bp smallint [null, note: 'mmHg, 입력 범위는 API에서 검사']    // 수축기 혈압 mmHg
  diastolic_bp smallint [null]                                      // 이완기 혈압 mmHg
  fasting_glucose smallint [null]                                   // 공복혈당 mg/dL
  waist_cm decimal(4,1) [null]                                      // 허리둘레 (cm, 소수점 첫째 자리까지)
  triglyceride smallint [null]                                      // 중성지방 mg/dL, 대사증후군 기준 ≥150 (11/19 데이터팀 요청)
  hdl_cholesterol smallint [null]                                   // HDL 콜레스테롤 mg/dL, 대사증후군 기준 남 <40 / 여 <50
  hba1c decimal(3,1) [null]                                         // 당화혈색소 %, 선택 입력. 당뇨 전단계 기준 ≥5.7
  source checkup_source [not null, default: 'MANUAL']
  created_at datetime [not null]
  updated_at datetime [not null]             // 오타 수정 및 빈 항목 추가 입력 추적용
  Note: 'REQ-PROF-002~003 · 검진 수치. 대시보드 혈압 그래프에는 안 씀(집 혈압은 health_logs) · 수치는 최소 1개 이상 입력(API에서 검사) · 키·몸무게·총콜레스테롤은 받지 않음(11/19 데이터팀) · 대사증후군 판정은 저장하지 않고 이 수치로 매번 계산(기준표 버전은 코드 상수)'
}

Enum prediction_method {
  MODEL              // 설문 모델 점수. 검진 수치가 있어도 항상 저장
  CHECKUP_CRITERIA   // 검진 수치 기준표 판정. score·model_version 없음
}

Enum disease_type {
  HYPERTENSION
  DIABETES
}

Enum risk_level {
  LOW             // 저위험 / 정상
  CAUTION         // 주의
  HIGH            // 고위험 / 위험
}

// "예측 한 번 = 결과 한 줄" 로 쌓는 기록용 테이블
Table risk_predictions {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  health_profile_id bigint [not null, ref: > health_profiles.id]
  checkup_record_id bigint [null]   // 검진 기록 삭제 시 null (ON DELETE SET NULL, 아래 Ref, 이력은 input_snapshot에 남음)
  disease disease_type [not null]          // 대사증후군은 행을 만들지 않음 (checkup_records로 매번 계산)
  method prediction_method [not null, default: 'MODEL']
  score tinyint [null]                     // 모델 확률 ×100 → 0~100 정수. CHECKUP_CRITERIA 행은 null
  level risk_level [not null]
  factors json [null]                      // 상위 3개 [{"feature": ..., "direction": "UP"|"DOWN"}]
  model_version varchar(50) [null]         // CHECKUP_CRITERIA 행은 null. MLflow 등록 이름:버전, 예: 'diabetes_risk:v1'
  input_snapshot json [not null]           // MODEL 행: inputs(설문 값, 변환 전) + model_inputs(모델에 넣은 값, 변환 후, api.md 5-0). CHECKUP_CRITERIA 행은 판정에 쓴 검진 수치 + checked_on (factors는 null, 11/19 장성은 확인)
  created_at datetime [not null]           // 예측 시각

  indexes {
    (user_id, disease, created_at)
  }

  Note: 'REQ-PRED-001~004, DASH-003 · 기록용(수정 없음) · 진단 여부가 예인 질환은 행을 만들지 않음 · level 기준값은 데이터팀이 12/4 전 확정 · 습관 시뮬레이션(PRED-003)은 저장하지 않음 · 검진 수치가 있으면 한 질환에 MODEL 행 + CHECKUP_CRITERIA 행 2개(11/19 데이터팀), 위험도 추이는 MODEL 행만'
}

// 인라인 ref는 delete 옵션을 못 달아서 따로 둠
Ref: risk_predictions.checkup_record_id > checkup_records.id [delete: set null]

Enum recommendation_type {
  DAILY_ACTION        // LLM-001 오늘의 한 가지
  MEAL_ALTERNATIVE    // LLM-002 대체 메뉴
  WEATHER_TIP         // LLM-003 날씨 기반 가이드
  RISK_EXPLANATION    // LLM-004 예측 요인 설명
  WEEKLY_REPORT       // LLM-005 주간 리포트
}

Enum generation_status {
  PENDING             // 생성 대기 (큐 등록 직후)
  PROCESSING          // LLM API 호출 및 생성 중
  COMPLETED           // 생성 완료 (화면 노출 가능)
  FAILED              // 생성 실패 (재시도 대상)
}

// LLM이 만든 결과를 저장해두고, 화면은 저장본을 보여주는 테이블
Table recommendations {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  rec_type recommendation_type [not null]
  target_on date [not null]                        // 추천 기준 날짜
  status generation_status [not null, default: 'PENDING']
  content text [null]                              // LLM 답변 본문 (생성 완료 전엔 null)
  sources json [null]                              // RAG 근거 출처 배열 (문서명, URL 등)
  risk_prediction_id bigint [null, ref: - risk_predictions.id]  // LLM-004 기준 예측
  meal_id bigint [null, ref: - meals.id]           // LLM-002 기준 식단
  model varchar(50) [null]                         // 예: 'claude-haiku-5-5'
  prompt_version varchar(30) [null]                // 예: 'daily_v1.2'
  retry_count int [not null, default: 0]           // 실패 시 재시도 횟수 (최대 3회)
  created_at datetime [not null]
  updated_at datetime [not null]                   // 상태 변경 추적

  indexes {
    meal_id [unique]                               // 식단 하나당 대체 메뉴 하나
    risk_prediction_id [unique]                    // 예측 하나당 설명 하나
    (user_id, rec_type, target_on)                 // 조회용, 유니크 아님
  }

  Note: 'REQ-LLM-001~005, NFR-002 · 대체 메뉴는 식단마다 1개, 요인 설명은 예측마다 1개(유니크) · 나머지는 하루 1번(API에서 검사) · 화면은 저장본 표시 · 에러 메시지는 저장하지 않음 · FAILED 후 재시도는 새 행을 만들지 않고 같은 행을 PENDING으로 되돌려 갱신(retry_count + 1, 1:1 유지)'
}

Enum llm_feature {
  DAILY_ACTION        // LLM-001 오늘의 한 가지
  MEAL_ALTERNATIVE    // LLM-002 대체 메뉴
  WEATHER_TIP         // LLM-003 날씨 기반 가이드
  RISK_EXPLANATION    // LLM-004 예측 요인 설명
  WEEKLY_REPORT       // LLM-005 주간 리포트
  MEAL_VISION         // 식단 사진 분석(비전 보조)
  RAG_EMBEDDING       // 벡터 검색용 임베딩 생성
}

// LLM 토큰 사용량 및 비용 모니터링(llm_usage_logs) 테이블
// 프롬프트 캐싱 토큰 분리와 호출 시점 단가 기준의 비용 기록(estimated_cost_usd)이 핵심
Table llm_usage_logs {
  id bigint [pk, increment]
  user_id bigint [null, ref: > users.id]
  recommendation_id bigint [null, ref: > recommendations.id]
  meal_id bigint [null, ref: > meals.id]                // MEAL_VISION일 때 기준 식단
  feature llm_feature [not null]
  model varchar(50) [not null]
  input_tokens int [not null, default: 0]
  output_tokens int [not null, default: 0]
  cache_creation_tokens int [not null, default: 0]      // 캐시 쓰기 토큰
  cache_read_tokens int [not null, default: 0]          // 캐시 읽기 토큰
  estimated_cost_usd decimal(10,6) [null]               // 호출 시점 단가 기준 산출 비용($)
  is_success bool [not null, default: true]
  created_at datetime [not null]

  indexes {
    (feature, created_at)      // 이번 달 기능별 사용량 조회용
    (user_id, created_at)      // 사용자별 하루 호출 수 조회용
  }

  Note: 'REQ-NFR-012 · 호출 1번 = 1행 · 프롬프트·답변 본문은 저장하지 않음 · 추천 종류는 recommendation_type과 같이 관리'
}

Enum notification_type {
  CHALLENGE_REMINDER    // NOTI-004 챌린지 리마인더 (스케줄형)
  PARTNER_ACTIVITY      // NOTI-005 짝꿍 완료·응원 (이벤트형)
  STREAK_ACHIEVED       // NOTI-006 연속 달성 (이벤트형)
  WEEKLY_REPORT         // NOTI-007 주간 리포트 (스케줄형)
  CUSTOM_REMINDER       // NOTI-009 (리마인더마다 시각, 설정 행은 전체 켜기·끄기용)
}

// 어떤 알림을, 언제 받을지 - 챌린지 리마인더, 짝꿍, 연속 달성, 주간 리포트
Table notification_settings {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  noti_type notification_type [not null]
  is_enabled bool [not null, default: true]
  days varchar(30) [null, note: '쉼표 구분 MON,TUE,WED,THU,FRI,SAT,SUN · 비어있으면 매일']
  notify_at time [null, note: '스케줄형만 사용, 이벤트형은 null']
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (user_id, noti_type) [unique]
  }

  Note: 'REQ-NOTI-001 · 사용자 × 알림 종류마다 1행 · 챌린지 리마인더는 모든 챌린지 공통 시각 1개 · 행이 없으면 기본값(켜짐)으로 봄 · 방해 금지 시간은 users.quiet_start/quiet_end'
}

// 웹 푸시를 보낼 "주소"를 기기마다 저장
Table push_subscriptions {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  endpoint varchar(512) [not null, unique]   // 브라우저 푸시 서비스 고유 URL
  p256dh varchar(255) [not null]             // 클라이언트 공개키 (Base64URL 인코딩)
  auth varchar(100) [not null]               // 인증 시크릿 (Base64URL 인코딩)
  user_agent varchar(512) [null]             // 기기·브라우저 식별용(예: 'Chrome on Android', 원문 UA)
  last_used_at datetime [null]               // 마지막 푸시 발송 성공 시각
  created_at datetime [not null]
  updated_at datetime [not null]             // 동일 기기 재구독/키 갱신 시 업데이트

  Note: 'REQ-NOTI-003 · 기기마다 1행 · 같은 endpoint가 다시 오면 user_id·키 갱신(upsert) · 로그아웃 시 그 기기 구독 삭제 · 발송 시 404/410이면 해당 행 즉시 삭제'
}

// 사용자가 직접 만드는 리마인더
Table custom_reminders {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  title varchar(100) [not null]               // 짝꿍 비공개, 로그 금지
  days varchar(30) [null, note: '쉼표 구분 MON,TUE,WED,THU,FRI,SAT,SUN · 비어있으면 매일']
  remind_at time [not null]                   // 알람 울릴 시각 (필수값)
  is_enabled bool [not null, default: true]
  created_at datetime [not null]
  updated_at datetime [not null]              // 제목, 요일, 시각, 활성화 여부 수정 추적

  indexes {
    (is_enabled, remind_at)                   // 매 분/5분마다 실행되는 스케줄러 조회 최적화
  }

  Note: 'REQ-NOTI-009 · 약 정보는 저장 안 함 · 방해 금지와 겹치면 저장 시 안내 + 발송은 스킵 · 1인당 최대 10개(API에서 검사) · 삭제 시 실제 삭제'
}

// 보낸 알림을 쌓아두는 기록
Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  noti_type notification_type [not null]
  title varchar(100) [not null]
  body varchar(255) [null]                      // 짧은 알림은 제목만 있을 수 있으므로 null 허용
  link varchar(255) [null]                      // 딥링크/라우트 경로
  read_at datetime [null]
  is_read bool [not null, default: false]
  is_push_sent bool [not null, default: false]  // 웹 푸시 발송 여부
  created_at datetime [not null]                // 알림 생성(발송) 시각

  indexes {
    (user_id, created_at)       // 유저별 최신순 알림 목록 조회용
    (user_id, is_read)          // 상단 벨 아이콘 안 읽은 알림 배지(COUNT) 조회용
  }

  Note: 'REQ-NOTI-002, 004~007, 009 · 보관 30일 · 본문은 로그 금지 · 수정은 읽음 처리뿐이라 read_at으로 대신함'
}

// ───────── 이지희 ─────────

Table challenge_templates {
  id bigint [pk, increment]
  title varchar(100) [not null]
  category varchar(30) [not null]   // 대문자 고정 7종: WALK / WATER / EXERCISE / STRETCH / LESS_ALCOHOL / WEIGHT / NO_SMOKING (11/19)
  default_times_per_week int [not null]
  created_at datetime [not null]
  Note: 'REQ-CHAL-001 · 기본 제공 목록'
}

Enum pair_status {
  PENDING
  ACCEPTED
  ENDED
}

Table pairs {
  id bigint [pk, increment]
  requester_id bigint [not null, ref: > users.id]
  partner_id bigint [null, ref: > users.id]
  invite_code varchar(128) [not null, unique]
  pair_key varchar(50) [null, unique]  // 작은 user_id:큰 user_id (예: '3:7'). 수락 시 채우고 ENDED 시 비움
  status pair_status [not null]
  accepted_at datetime [null]
  updated_at datetime [not null]
  created_at datetime [not null]
  Note: 'REQ-PAIR-001 · 같은 두 사람 사이 짝꿍은 하나만 → pair_key unique로 A→B·B→A 중복을 DB에서 막음 (11/19)'
}

Enum challenge_status {
  ACTIVE
  COMPLETED
  ENDED
}

Table challenges {
  id bigint [pk, increment]
  created_by bigint [not null, ref: > users.id]   // 현재 호스트(owner). 1:N에서 호스트가 나가면 넘겨받은 사람으로 바뀜 (11/19)
  challenge_template_id bigint [null, ref: > challenge_templates.id]
  pair_id bigint [null, ref: > pairs.id]
  title varchar(100) [not null]
  times_per_week int [not null]
  starts_on date [not null]
  ends_on date [null]
  status challenge_status [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'REQ-CHAL-001, PAIR-002 · pair_id는 1:1 짝꿍 챌린지만. 1:N은 비우고 참여자는 challenge_participants로 관리 (11/19 안 A) · 혼자/1:1/1:N(mode)은 저장하지 않고 응답에서 계산: pair_id 있으면 PAIR, 남은 참여자 2명 이상 GROUP, 그 외 SOLO'
}

Enum participant_status {
  INVITED
  JOINED
  LEFT
}

Table challenge_participants {
  id bigint [pk, increment]
  challenge_id bigint [not null, ref: > challenges.id]
  user_id bigint [not null, ref: > users.id]
  status participant_status [not null, default: 'INVITED']  // 만든 사람은 JOINED로 생성
  times_per_week int [null]  // 개인 목표 횟수. 비어 있으면 challenges.times_per_week 사용
  joined_at datetime [null]  // 수락한 시각 (created_at = 초대한 시각)
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (challenge_id, user_id) [unique]
  }

  Note: 'REQ-PAIR-002 · 1:N은 2~4명, 만든 사람의 짝꿍만 초대(API 검사). 서로 완료 여부만 공개'
}

Table challenge_checks {
  id bigint [pk, increment]
  challenge_id bigint [not null, ref: > challenges.id]
  user_id bigint [not null, ref: > users.id]
  checked_on date [not null]
  created_at datetime [not null]

  indexes {
    (challenge_id, user_id, checked_on) [unique]
  }

  Note: 'REQ-CHAL-002~003, PAIR-003 · 짝꿍에게 보이는 유일한 정보'
}

Table cheers {
  id bigint [pk, increment]
  from_user_id bigint [not null, ref: > users.id]
  to_user_id bigint [not null, ref: > users.id]
  challenge_id bigint [null, ref: > challenges.id]
  message varchar(255) [not null]
  created_at datetime [not null]
  Note: 'REQ-PAIR-004'
}

Enum health_log_type {
  BLOOD_PRESSURE
  BLOOD_GLUCOSE
  ALCOHOL
  EXERCISE
  STEPS
  CONDITION
  WEIGHT
  // 주간 기록 (주 1번, measured_at = 그 주 월요일 00:00 KST, value / value2 / unit)
  WALK_DAYS       // 0~7 / - / days_per_week
  STRENGTH_DAYS   // 0~5 (5 = 5일 이상) / - / days_per_week
  SITTING_HOURS   // 0~24 / - / hours_per_day
  SLEEP           // 주중 시간 / 주말 시간 / hours_per_day
  BREAKFAST       // 거의 안 함 0 · 주1~2 1 · 주3~4 2 · 주5~7 3 / - / null
  STRESS          // 거의 안 느낌 0 · 조금 1 · 많이 2 · 대단히 많이 3 / - / null
}

Table health_logs {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  log_type health_log_type [not null]
  value decimal(10,2) [not null]
  value2 decimal(10,2) [null]
  unit varchar(20) [null]
  measured_at datetime [not null]
  memo varchar(500) [null]
  created_at datetime [not null]

  indexes {
    (user_id, log_type, measured_at)
  }

  Note: 'REQ-DASH-001~002, 005 · 집 혈압·혈당·음주·운동량 · 주간 기록 6종은 한 사람·한 주·종류마다 1행, 다시 입력하면 덮어씀(API에서 검사, 혈압처럼 하루 여러 번 재는 기록 때문에 유니크 제약은 안 둠) · 주간 기록 값은 예측에 안 써서 국건영 코드가 아닌 우리 코드'
}

Enum serving_unit {
  G
  ML
}

Table foods {
  id bigint [pk, increment]
  name varchar(150) [not null]
  serving_size decimal(10,2) [null]   // 1인분 양
  serving_unit serving_unit [null]    // G / ML (식약처 기준량 단위)
  mfds_code varchar(100) [unique]
  model_label varchar(100) [unique]
  kcal decimal(10,2) [null]
  carbs_g decimal(10,2) [null]
  sugar_g decimal(10,2) [null]
  sodium_mg decimal(10,2) [null]
  protein_g decimal(10,2) [null]
  fat_g decimal(10,2) [null]
  created_at datetime [not null]
  Note: 'REQ-FOOD-002 · 식약처 영양 DB'
}

Enum meal_category {
  MEAL
  DRINK
  DESSERT
}

Enum meal_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Table meals {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  food_id bigint [null, ref: > foods.id]
  image_url varchar(2048) [not null]
  eaten_at datetime [not null]
  category meal_category [not null, default: 'MEAL']
  status meal_status [not null, default: 'PENDING']
  retry_count int [not null, default: 0]
  model_version varchar(50) [null]
  candidates json [null]
  portion decimal(2,1) [not null, default: 1.0]
  nutrients json [null]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (user_id, eaten_at)
  }

  Note: 'REQ-FOOD-001~003 · 분류는 워커가 비동기로 채움'
}

TableGroup user_profile {  // 회원·동의·설문·검진
  users
  user_consents
  health_profiles
  checkup_records
}

TableGroup prediction {  // 위험도 예측
  risk_predictions
}

TableGroup challenge_pair {  // 챌린지·짝꿍
  challenge_templates
  challenges
  challenge_participants
  challenge_checks
  pairs
  cheers
}

TableGroup health_record {  // 집에서 잰 기록
  health_logs
}

TableGroup meal {  // 식단
  foods
  meals
}

TableGroup llm {  // LLM 추천·사용량
  recommendations
  llm_usage_logs
}

TableGroup notification {  // 알림
  notification_settings
  push_subscriptions
  custom_reminders
  notifications
}
